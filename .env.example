# --- Neon (Postgres) ---
# read directly by serving/db.py
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- MLflow via DagsHub ---
# MLFLOW_TRACKING_URI is read directly by config.py
# MLFLOW_TRACKING_USERNAME / MLFLOW_TRACKING_PASSWORD are not read by our code,
# mlflow's client picks them up itself for DagsHub's basic auth
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- DVC remote (DagsHub), for local `dvc pull` / `dvc push` ---
# not read by our code, consumed by `dvc remote modify --local` (see README)
DAGSHUB_USERNAME=
DAGSHUB_TOKEN=

# --- LLM explanation feature ---
# read directly by dashboard/llm_explain.py
GROQ_API_KEY=

# --- Serving ---
# read directly by scripts/replay_batch.py; the deployed FastAPI base URL
API_URL=http://localhost:8000

# --- Tracing ---
# read by logfire.configure() automatically; get one at https://logfire.pydantic.dev
LOGFIRE_TOKEN=
